{
  "name": "tellerx-chatbot-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --config frontend/vite.config.js",
    "backend": "tellerx-backend",
    "local": "concurrently --kill-others --kill-signal SIGINT --names backend,frontend --prefix-colors blue,green \"npm:backend\" \"npm:dev\"",
    "build": "vite build --config frontend/vite.config.js",
    "test": "node --test frontend/src/knowledge/*.test.js",
    "preview": "vite preview --config frontend/vite.config.js"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.5",
    "vite": "8.2.1"
  }
}
