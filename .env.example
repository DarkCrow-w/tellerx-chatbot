APP_ENV=development
# 日常运行建议 INFO；排障时临时改为 DEBUG。日志输出到标准输出，供终端或 IKP 采集。
LOG_LEVEL=INFO
# 替换为 IKP PostgreSQL Service 的 Internal Endpoint、数据库名和账号。
# 密码包含 @、:、/、#、% 时必须先做 URL 编码；是否启用 sslmode=require 以公司要求为准。
DATABASE_URL=postgresql+psycopg://tellerx_app:CHANGE_ME@postgresql.namespace.svc.cluster.local:5432/tellerx?sslmode=require
SEARCH_BACKEND=postgresql-pgvector-fts
POSTGRES_SEARCH_TABLE=chunk_search_index
POSTGRES_SEARCH_SCHEMA_VERSION=1
PGVECTOR_HNSW_EF_SEARCH=200
STORAGE_ROOT=.local-data/knowledge
# 直接填写公司模型网关 Token；不要把真实 .env 提交到 Git。
MODEL_API_KEY="CHANGE_ME"
MODEL_API_BASE_URL=https://sdk-endpoint.example.internal/v1
MODEL_API_JSON_MODE_ENABLED=true
MODEL_API_TIMEOUT_SECONDS=60
MODEL_API_MAX_RETRIES=2
EMBEDDING_MODEL=qwen3-embedding
EMBEDDING_DIMENSIONS=1024
EMBEDDING_PREPROCESS_VERSION=normalized-text-v1
VECTOR_MIN_SIMILARITY=0.25
RERANK_ENABLED=false
SEMANTIC_QUERY_UNDERSTANDING_ENABLED=true
QUERY_PLAN_CACHE_SIZE=500
QUERY_PLAN_CACHE_TTL_SECONDS=3600
MODEL_REGISTRY_PATH=config/models.yaml
ALLOW_BM25_ONLY=true
# 本地核心版由 API 后台任务完成解析、向量化和索引发布。
RUN_INLINE_INGESTION=true
PARSER_BACKEND=native
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
