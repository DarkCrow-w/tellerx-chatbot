APP_ENV=development
DATABASE_URL=postgresql+psycopg://knowledge:knowledge@postgres:5432/knowledge
SEARCH_BACKEND=postgresql-pgvector-fts
POSTGRES_SEARCH_TABLE=chunk_search_index
POSTGRES_SEARCH_SCHEMA_VERSION=1
PGVECTOR_HNSW_EF_SEARCH=200
STORAGE_ROOT=/data/knowledge
MODEL_API_KEY_FILE=/run/secrets/model_api_key
MODEL_API_BASE_URL=https://sdk-endpoint.example.internal/v1
MODEL_API_JSON_MODE_ENABLED=true
MODEL_API_TIMEOUT_SECONDS=60
MODEL_API_MAX_RETRIES=2
EMBEDDING_MODEL=qwen3-embedding
EMBEDDING_DIMENSIONS=1024
EMBEDDING_PREPROCESS_VERSION=normalized-text-v1
VECTOR_MIN_SIMILARITY=0.25
RERANK_ENABLED=false
SEMANTIC_QUERY_UNDERSTANDING_ENABLED=true
QUERY_PLAN_CACHE_SIZE=500
QUERY_PLAN_CACHE_TTL_SECONDS=3600
MODEL_REGISTRY_PATH=/app/config/models.yaml
ALLOW_BM25_ONLY=true
RUN_INLINE_INGESTION=false
PARSER_BACKEND=native
INDEX_RECONCILE_INTERVAL_SECONDS=3600
